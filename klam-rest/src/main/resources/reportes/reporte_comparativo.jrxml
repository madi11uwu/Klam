<jasperReport name="reporte_comparativo" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
	<parameter name="titulo" class="java.lang.String"/>
	<parameter name="generado" class="java.lang.String"/>
	<parameter name="periodo" class="java.lang.String"/>
	<parameter name="criterios" class="java.lang.String"/>
	<parameter name="logo" class="java.awt.Image"/>
	<parameter name="subreporteLineas" class="net.sf.jasperreports.engine.JasperReport"/>
	<field name="idCirugia" class="java.lang.Integer"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="procedimiento" class="java.lang.String"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="documentoPaciente" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="lineas" class="java.util.List"/>
	<title height="95" splitType="Stretch">
		<element kind="image" x="480" y="5" width="65" height="60">
			<expression><![CDATA[$P{logo}]]></expression>
		</element>
		<element kind="textField" x="0" y="0" width="470" height="22" fontName="Helvetica" fontSize="14.0" bold="true">
			<expression><![CDATA[$P{titulo}]]></expression>
		</element>
		<element kind="textField" x="0" y="24" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Generado: " + $P{generado}]]></expression>
		</element>
		<element kind="textField" x="0" y="40" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Periodo: " + $P{periodo}]]></expression>
		</element>
		<element kind="textField" textAdjust="StretchHeight" x="0" y="56" width="470" height="32" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA[$P{criterios}]]></expression>
		</element>
	</title>
	<detail>
		<band height="95" splitType="Stretch">
			<element kind="textField" x="0" y="6" width="555" height="16" fontName="Helvetica" fontSize="10.0" bold="true">
				<expression><![CDATA["CIR-" + String.format("%03d", $F{idCirugia}) + " · " + ($F{procedimiento} != null ? $F{procedimiento} : "—")]]></expression>
			</element>
			<element kind="textField" x="0" y="22" width="555" height="14" fontName="Helvetica" fontSize="9.0">
				<expression><![CDATA["Fecha: " + ($F{fecha} != null ? $F{fecha} : "—") + "   Paciente: " + ($F{paciente} != null && !$F{paciente}.isBlank() ? $F{paciente} : "—") + "   Documento: " + ($F{documentoPaciente} != null && !$F{documentoPaciente}.isBlank() ? $F{documentoPaciente} : "—")]]></expression>
			</element>
			<element kind="textField" x="0" y="36" width="555" height="14" fontName="Helvetica" fontSize="9.0">
				<expression><![CDATA["Médico: " + ($F{medico} != null && !$F{medico}.isBlank() ? $F{medico} : "—") + "   Cliente: " + ($F{cliente} != null && !$F{cliente}.isBlank() ? $F{cliente} : "—")]]></expression>
			</element>
			<element kind="subreport" x="0" y="54" width="555" height="32">
				<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($F{lineas})]]></dataSourceExpression>
				<expression><![CDATA[$P{subreporteLineas}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30" splitType="Stretch">
		<element kind="textField" x="355" y="5" width="120" height="20" fontName="Helvetica" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
		</element>
		<element kind="textField" evaluationTime="Report" x="475" y="5" width="80" height="20" fontName="Helvetica" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle">
			<expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<noData height="140" splitType="Stretch">
		<element kind="image" x="480" y="5" width="65" height="60">
			<expression><![CDATA[$P{logo}]]></expression>
		</element>
		<element kind="textField" x="0" y="0" width="470" height="22" fontName="Helvetica" fontSize="14.0" bold="true">
			<expression><![CDATA[$P{titulo}]]></expression>
		</element>
		<element kind="textField" x="0" y="24" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Generado: " + $P{generado}]]></expression>
		</element>
		<element kind="textField" x="0" y="40" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Periodo: " + $P{periodo}]]></expression>
		</element>
		<element kind="textField" textAdjust="StretchHeight" x="0" y="56" width="470" height="32" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA[$P{criterios}]]></expression>
		</element>
		<element kind="staticText" x="0" y="105" width="555" height="20" fontName="Helvetica" fontSize="10.0">
			<text><![CDATA[No hay cirugías con consumo completo con los criterios seleccionados.]]></text>
		</element>
	</noData>
</jasperReport>
