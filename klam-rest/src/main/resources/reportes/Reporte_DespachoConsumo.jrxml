<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Reporte_DespachoConsumo" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e1f2a3b4-c5d6-7e8f-9a0b-1c2d3e4f5a6b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="KlamReportes"/>
	<parameter name="id_cirugia" class="java.lang.Integer"/>
	<parameter name="subreporte" class="java.lang.String"/>
	<parameter name="logo" class="java.awt.Image"/>
	<query language="SQL"><![CDATA[call reporte_comparativo_cirugia($P{id_cirugia});]]></query>
	<field name="id_cirugia" class="java.lang.Integer"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="tipo_procedimiento" class="java.lang.String"/>
	<field name="medico" class="java.lang.String"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="documento_paciente" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<title height="80">
		<element kind="staticText" x="0" y="10" width="350" height="25" fontSize="16.0" bold="true">
			<text><![CDATA[BIOKLAM - DESPACHO Y CONSUMO]]></text>
		</element>
		<element kind="staticText" x="0" y="38" width="60" height="20" fontSize="11.0" bold="true">
			<text><![CDATA[Cirugía:]]></text>
		</element>
		<element kind="textField" x="65" y="38" width="120" height="20" fontSize="11.0">
			<expression><![CDATA[String.format("CIR-%04d", $F{id_cirugia})]]></expression>
		</element>
		<element kind="image" x="480" y="5" width="65" height="60">
			<expression><![CDATA[$P{logo}]]></expression>
		</element>
	</title>
	<pageHeader height="75">
		<element kind="staticText" x="0" y="5" width="80" height="18" bold="true"><text><![CDATA[Fecha:]]></text></element>
		<element kind="textField" x="80" y="5" width="180" height="18"><expression><![CDATA[$F{fecha}]]></expression></element>
		
		<element kind="staticText" x="280" y="5" width="80" height="18" bold="true"><text><![CDATA[Procedimiento:]]></text></element>
		<element kind="textField" x="360" y="5" width="190" height="18"><expression><![CDATA[$F{tipo_procedimiento}]]></expression></element>
		
		<element kind="staticText" x="0" y="27" width="80" height="18" bold="true"><text><![CDATA[Paciente:]]></text></element>
		<element kind="textField" x="80" y="27" width="180" height="18"><expression><![CDATA[$F{paciente} + " (" + $F{documento_paciente} + ")"]]></expression></element>
		
		<element kind="staticText" x="280" y="27" width="80" height="18" bold="true"><text><![CDATA[Médico:]]></text></element>
		<element kind="textField" x="360" y="27" width="190" height="18"><expression><![CDATA[$F{medico}]]></expression></element>

		<element kind="staticText" x="0" y="49" width="80" height="18" bold="true"><text><![CDATA[Cliente:]]></text></element>
		<element kind="textField" x="80" y="49" width="470" height="18"><expression><![CDATA[$F{cliente}]]></expression></element>
	</pageHeader>
	<detail>
		<band height="60">
			<element kind="subreport" x="0" y="10" width="555" height="45">
				<connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression>
				<expression><![CDATA[$P{subreporte}]]></expression>
				<parameter name="id_cirugia">
					<expression><![CDATA[$F{id_cirugia}]]></expression>
				</parameter>
			</element>
		</band>
	</detail>
</jasperReport>
