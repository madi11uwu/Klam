<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="Reporte_DetalleDespachoConsumo" language="java" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5c6e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="KlamReportes"/>
	<parameter name="id_cirugia" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[call reporte_comparativo_detalle($P{id_cirugia});]]></query>
	<field name="insumo" class="java.lang.String"/>
	<field name="medida" class="java.lang.String"/>
	<field name="despachada" class="java.lang.Integer"/>
	<field name="consumida" class="java.lang.Integer"/>
	<field name="diferencia" class="java.lang.Integer"/>
	<variable name="SUMA_DESPACHADA" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{despachada}]]></expression>
	</variable>
	<variable name="SUMA_CONSUMIDA" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{consumida}]]></expression>
	</variable>
	<variable name="SUMA_DIFERENCIA" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{diferencia}]]></expression>
	</variable>
	<columnHeader height="25">
		<element kind="staticText" x="0" y="0" width="215" height="20" fontSize="10.0" bold="true" underline="true">
			<text><![CDATA[INSUMO]]></text>
		</element>
		<element kind="staticText" x="215" y="0" width="80" height="20" fontSize="10.0" bold="true" underline="true">
			<text><![CDATA[MEDIDA]]></text>
		</element>
		<element kind="staticText" x="295" y="0" width="80" height="20" fontSize="10.0" bold="true" underline="true" hTextAlign="Right">
			<text><![CDATA[DESPACHADA]]></text>
		</element>
		<element kind="staticText" x="380" y="0" width="80" height="20" fontSize="10.0" bold="true" underline="true" hTextAlign="Right">
			<text><![CDATA[CONSUMIDA]]></text>
		</element>
		<element kind="staticText" x="465" y="0" width="80" height="20" fontSize="10.0" bold="true" underline="true" hTextAlign="Right">
			<text><![CDATA[DIFERENCIA]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="20">
			<element kind="textField" x="0" y="0" width="215" height="18">
				<expression><![CDATA[$F{insumo}]]></expression>
			</element>
			<element kind="textField" x="215" y="0" width="80" height="18">
				<expression><![CDATA[$F{medida} != null ? $F{medida} : "-"]]></expression>
			</element>
			<element kind="textField" x="295" y="0" width="80" height="18" hTextAlign="Right">
				<expression><![CDATA[$F{despachada}]]></expression>
			</element>
			<element kind="textField" x="380" y="0" width="80" height="18" hTextAlign="Right">
				<expression><![CDATA[$F{consumida}]]></expression>
			</element>
			<element kind="textField" x="465" y="0" width="80" height="18" hTextAlign="Right">
				<expression><![CDATA[$F{diferencia}]]></expression>
			</element>
		</band>
	</detail>
	<summary height="30">
		<element kind="staticText" x="180" y="5" width="100" height="20" fontSize="10.0" bold="true" hTextAlign="Right">
			<text><![CDATA[TOTALES:]]></text>
		</element>
		<element kind="textField" x="295" y="5" width="80" height="20" fontSize="10.0" bold="true" hTextAlign="Right">
			<expression><![CDATA[$V{SUMA_DESPACHADA}]]></expression>
		</element>
		<element kind="textField" x="380" y="5" width="80" height="20" fontSize="10.0" bold="true" hTextAlign="Right">
			<expression><![CDATA[$V{SUMA_CONSUMIDA}]]></expression>
		</element>
		<element kind="textField" x="465" y="5" width="80" height="20" fontSize="10.0" bold="true" hTextAlign="Right">
			<expression><![CDATA[$V{SUMA_DIFERENCIA}]]></expression>
		</element>
	</summary>
</jasperReport>
