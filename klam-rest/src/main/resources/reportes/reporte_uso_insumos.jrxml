<jasperReport name="reporte_uso_insumos" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
	<parameter name="titulo" class="java.lang.String"/>
	<parameter name="generado" class="java.lang.String"/>
	<parameter name="periodo" class="java.lang.String"/>
	<parameter name="criterios" class="java.lang.String"/>
	<parameter name="logo" class="java.awt.Image"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="medida" class="java.lang.String"/>
	<field name="tipoProcedimiento" class="java.lang.String"/>
	<field name="cantidadUtilizada" class="java.lang.Integer"/>
	<field name="frecuencia" class="java.lang.Integer"/>
	<title height="95" splitType="Stretch">
		<element kind="image" x="480" y="5" width="65" height="60">
			<expression><![CDATA[$P{logo}]]></expression>
		</element>
		<element kind="textField" x="0" y="0" width="470" height="22" fontName="Helvetica" fontSize="14.0" bold="true">
			<expression><![CDATA[$P{titulo}]]></expression>
		</element>
		<element kind="textField" x="0" y="24" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Generado: " + $P{generado}]]></expression>
		</element>
		<element kind="textField" x="0" y="40" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Periodo: " + $P{periodo}]]></expression>
		</element>
		<element kind="textField" textAdjust="StretchHeight" x="0" y="56" width="470" height="32" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA[$P{criterios}]]></expression>
		</element>
	</title>
	<columnHeader height="24" splitType="Stretch">
		<element kind="staticText" mode="Opaque" backcolor="#E0E0E0" x="0" y="0" width="190" height="24" fontName="Helvetica" fontSize="10.0" bold="true" vTextAlign="Middle">
			<box leftPadding="4">
				<pen lineWidth="0.5" lineColor="#B0B0B0"/>
			</box>
			<text><![CDATA[Insumo]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#E0E0E0" x="190" y="0" width="65" height="24" fontName="Helvetica" fontSize="10.0" bold="true" vTextAlign="Middle">
			<box leftPadding="4">
				<pen lineWidth="0.5" lineColor="#B0B0B0"/>
			</box>
			<text><![CDATA[Medida]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#E0E0E0" x="255" y="0" width="150" height="24" fontName="Helvetica" fontSize="10.0" bold="true" vTextAlign="Middle">
			<box leftPadding="4">
				<pen lineWidth="0.5" lineColor="#B0B0B0"/>
			</box>
			<text><![CDATA[Tipo de cirugía]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#E0E0E0" x="405" y="0" width="75" height="24" fontName="Helvetica" fontSize="10.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<box rightPadding="4">
				<pen lineWidth="0.5" lineColor="#B0B0B0"/>
			</box>
			<text><![CDATA[Cantidad utilizada]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#E0E0E0" x="480" y="0" width="75" height="24" fontName="Helvetica" fontSize="10.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<box rightPadding="4">
				<pen lineWidth="0.5" lineColor="#B0B0B0"/>
			</box>
			<text><![CDATA[Frecuencia de uso]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="20" splitType="Stretch">
			<element kind="textField" textAdjust="StretchHeight" x="0" y="0" width="190" height="20" fontName="Helvetica" fontSize="9.0" vTextAlign="Middle">
				<box leftPadding="4">
					<pen lineWidth="0.25" lineColor="#D0D0D0"/>
				</box>
				<expression><![CDATA[$F{nombre} != null ? $F{nombre} : "—"]]></expression>
			</element>
			<element kind="textField" x="190" y="0" width="65" height="20" fontName="Helvetica" fontSize="9.0" vTextAlign="Middle">
				<box leftPadding="4">
					<pen lineWidth="0.25" lineColor="#D0D0D0"/>
				</box>
				<expression><![CDATA[$F{medida} != null ? $F{medida} : "—"]]></expression>
			</element>
			<element kind="textField" textAdjust="StretchHeight" x="255" y="0" width="150" height="20" fontName="Helvetica" fontSize="9.0" vTextAlign="Middle">
				<box leftPadding="4">
					<pen lineWidth="0.25" lineColor="#D0D0D0"/>
				</box>
				<expression><![CDATA[$F{tipoProcedimiento} != null ? $F{tipoProcedimiento} : "—"]]></expression>
			</element>
			<element kind="textField" x="405" y="0" width="75" height="20" fontName="Helvetica" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
				<box rightPadding="4">
					<pen lineWidth="0.25" lineColor="#D0D0D0"/>
				</box>
				<expression><![CDATA[$F{cantidadUtilizada} != null ? $F{cantidadUtilizada} : 0]]></expression>
			</element>
			<element kind="textField" x="480" y="0" width="75" height="20" fontName="Helvetica" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
				<box rightPadding="4">
					<pen lineWidth="0.25" lineColor="#D0D0D0"/>
				</box>
				<expression><![CDATA[$F{frecuencia} != null ? $F{frecuencia} : 0]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="30" splitType="Stretch">
		<element kind="textField" x="355" y="5" width="120" height="20" fontName="Helvetica" fontSize="9.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
		</element>
		<element kind="textField" evaluationTime="Report" x="475" y="5" width="80" height="20" fontName="Helvetica" fontSize="9.0" hTextAlign="Left" vTextAlign="Middle">
			<expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<noData height="140" splitType="Stretch">
		<element kind="image" x="480" y="5" width="65" height="60">
			<expression><![CDATA[$P{logo}]]></expression>
		</element>
		<element kind="textField" x="0" y="0" width="470" height="22" fontName="Helvetica" fontSize="14.0" bold="true">
			<expression><![CDATA[$P{titulo}]]></expression>
		</element>
		<element kind="textField" x="0" y="24" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Generado: " + $P{generado}]]></expression>
		</element>
		<element kind="textField" x="0" y="40" width="470" height="16" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA["Periodo: " + $P{periodo}]]></expression>
		</element>
		<element kind="textField" textAdjust="StretchHeight" x="0" y="56" width="470" height="32" fontName="Helvetica" fontSize="10.0">
			<expression><![CDATA[$P{criterios}]]></expression>
		</element>
		<element kind="staticText" x="0" y="105" width="555" height="20" fontName="Helvetica" fontSize="10.0">
			<text><![CDATA[No hay consumos registrados con los criterios seleccionados.]]></text>
		</element>
	</noData>
</jasperReport>
